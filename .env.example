# ──────────────────────────────────────────────────────────────────────────────
# SHPE OSU — Environment Variables (template)
# ──────────────────────────────────────────────────────────────────────────────
# Setup:
#   cp .env.example .env
# then fill in the values from Supabase Dashboard → Project Settings → API.
#
# `.env` is gitignored and must never be committed. This template is committed
# on purpose so new contributors know which variables the app requires — the
# app throws on startup (see src/lib/supabase.js) if either is missing.
#
# Anything prefixed VITE_ is inlined into the public JS bundle at build time.
# Only ever put publishable values here. The anon key is safe to expose *only*
# because Row-Level Security restricts what it can reach — never put the
# service_role key in this file.
#
# These must also be set in Vercel → Settings → Environment Variables for
# production deploys; a local .env alone will not configure the live site.
#
# To rotate: Supabase Dashboard → Project Settings → API → Roll anon key, then
# update both .env and the Vercel environment variables.
# ──────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public Cloudflare Turnstile site key shared by protected submission widgets
# (attendance, resume, and sponsor inquiry). Each endpoint verifies its own
# action server-side, so tokens cannot be reused across forms.
# Restrict the widget to shpeosu.com and www.shpeosu.com in Cloudflare. Its
# secret counterpart belongs ONLY in Supabase Edge Function secrets.
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
