# Local Supabase Edge Function secrets. Copy to supabase/functions/.env and use
# only test/staging values there. Never commit the real file.

# Cloudflare's documented always-pass test secret. Replace it in deployed Edge
# Function secrets with the real secret paired to VITE_TURNSTILE_SITE_KEY.
# The handlers reject Cloudflare's test secrets whenever SUPABASE_URL is not a
# recognized local Supabase URL, so copying this file to hosted Edge fails closed.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=dummy-key-pass,localhost,127.0.0.1

# Generate at least 32 random bytes. Rotating this resets rate-limit identities;
# it never belongs in Vite or any other browser-visible variable.
RATE_LIMIT_HMAC_SECRET=replace-with-a-long-random-server-secret

# Comma-separated browser origins. CORS is containment, not authentication.
PUBLIC_SITE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Sponsor email delivery. These are Edge-only secrets: never prefix them VITE_.
# In EmailJS Account → Security, require the private key before cutover; merely
# sending accessToken here does not disable the already-public browser route.
EMAILJS_SERVICE_ID=replace-with-service-id
EMAILJS_TEMPLATE_ID=replace-with-template-id
EMAILJS_PUBLIC_KEY=replace-with-public-key
EMAILJS_PRIVATE_KEY=replace-with-private-key

# The current EmailJS Free plan allows 200 requests/month. Five/day plus a
# fixed-window 150-per-31-days cap leaves room for tests and manual dashboard use.
# Tune these only after confirming the account's actual plan and usage.
SPONSOR_INQUIRY_DAILY_LIMIT=5
SPONSOR_INQUIRY_MONTHLY_LIMIT=150
